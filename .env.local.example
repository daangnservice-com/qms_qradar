# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# 처리 설정 (콜 품질 평가)
SILENCE_NOISE_DB=-30
MAX_UPLOAD_MB=200

# 처리 설정 (파손 판별)
MAX_IMAGES=8
MAX_IMAGE_MB=10

# SSO (Google OAuth) — 구글 클라우드 콘솔에서 발급
# 리디렉션 URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXTAUTH_SECRET=          # openssl rand -base64 32
NEXTAUTH_URL=http://localhost:3000
ALLOWED_EMAIL_DOMAIN=daangnservice.com
