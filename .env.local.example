# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# 처리 설정 (콜 품질 평가)
SILENCE_NOISE_DB=-30
MAX_UPLOAD_MB=200

# SSO (Google OAuth) — 로그인용. 레포에 실키 없음. 콘솔에서 발급 후 로컬 .env.local에만.
# 리디렉션 URI: http://localhost:3000/api/auth/callback/google
#
# Google은 Origin/Redirect에 raw IP를 허용하지 않음(localhost만 예외).
# 같은 네트워크 다른 PC에서 쓰려면 nip.io 호스트를 쓴다 (공인 TLD, IP로 resolve):
#   Origin:   http://<LAN-IP>.nip.io:3000
#   Redirect: http://<LAN-IP>.nip.io:3000/api/auth/callback/google
#   접속:     http://<LAN-IP>.nip.io:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXTAUTH_SECRET=          # openssl rand -base64 32
NEXTAUTH_URL=http://localhost:3000
# 개발 서버는 Host 헤더로 NEXTAUTH_URL을 맞춘다. next start로 LAN 테스트 시에도 켜기.
AUTH_TRUST_HOST=true
ALLOWED_EMAIL_DOMAIN=daangnservice.com

# Google Groups 멤버십 (Admin SDK Directory API)
# 로컬(사용자 ADC): Workspace 관리자(또는 Groups 조회 가능) 계정으로 아래 스코프 포함 로그인.
#   gcloud auth application-default login --scopes=https://www.googleapis.com/auth/cloud-platform,https://www.googleapis.com/auth/admin.directory.group.member.readonly
#   → GOOGLE_WORKSPACE_IMPERSONATE_EMAIL 불필요. (SA JSON과 공존 시 Groups는 사용자 ADC 우선)
# 배포(SA): Domain-wide Delegation + impersonate 대상(관리자) 이메일 필요.
# GOOGLE_WORKSPACE_IMPERSONATE_EMAIL=admin@daangnservice.com
# GOOGLE_GROUPS_CACHE_TTL_MS=600000

# ── GCP (BigQuery / GCS / STT) ──────────────────────────────────────
# 레포·코드에 키/토큰 없음. 배포는 호스트 env, 로컬은 아래를 같이 쓴다.
#
# BigQuery / Speech: ADC (`gcloud auth application-default login`).
#   SA JSON이 있어도 ADC 파일을 우선한다.
# GCS: GOOGLE_SERVICE_ACCOUNT_JSON 있으면 그 SA, 없으면 ADC.
# Groups: 사용자 ADC 또는 SA(+DWD impersonate). 위 Groups 섹션 참고.
#
# GCS: 서비스계정 키 JSON 한 줄 (없으면 ADC)
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...@....iam.gserviceaccount.com",...}

# BigQuery 타겟 — lib/bqRefs.ts
#   BQ_TARGET=dev  → data-proj-470202.ds_qradar_dev  (테이블명 동일, qradar_ 접두)
#   BQ_TARGET=prod → data-proj-470202.ds_qradar_prod
# BQ_TARGET=dev
#
# 적재 데이터셋 강제 오버라이드(기본은 타겟별 ds_qradar_*)
# QRADAR_DATASET=ds_qradar_dev
# QRADAR_LOCATION=US
#
# 프로젝트/공유 입력(케이스·기준 뷰) — 타겟과 무관하게 ds_growth_culture
# GROWTH_CULTURE_PROJECT_ID=data-proj-470202
# GROWTH_CULTURE_LOCATION=US
# EVAL_SHARED_DATASET=ds_growth_culture
# EVAL_CASES_TABLE=ds_growth_culture.qradar_evaluation_cases
# EVAL_RESULTS_TABLE=qradar_evaluation_results
# EVAL_RESULTS_TABLE_PAY=qradar_evaluation_results_pay
# EVAL_CRITERIA_VIEW=ds_growth_culture.vw_evaluation_criterions
# Train 레퍼런스(전화채널 멀티팀). 뷰명에 pay가 남아 있어도 알바·광고 등 포함.
# QA_REFERENCES_VIEW=ds_growth_culture.vw_qradar_evaluation_case_references_pay_phone_inquries
# 6월 이전 score_detail 은 criterion id 체계가 달라 제외 (YYYY-MM-01)
# QA_REFERENCES_MIN_YEAR_MONTH=2026-06-01
#
# 인앱 문의(feedback) 원천 — 집계 뷰. 기본값은 karrotmarket.team_operation...
FEEDBACK_PROJECT=karrotmarket
FEEDBACK_SOURCE_VIEW=team_operation.vw_feedback_thread_aggregation
FEEDBACK_LOCATION=US
# 운영에서는 무거운 원천 뷰 대신 이 스냅샷 테이블을 읽는 수집 작업으로 전환한다.
FEEDBACK_SNAPSHOT_TABLE=evaluation_feedback_items
#
# QMS 결과 대시보드(케이스 상세) — 공유 뷰 직접 조회 (qradar 복사 없음)
# QMS_CASES_DETAIL_VIEW=ds_growth_culture.vw_quality_evaluation_cases_detail_with_fallback
#
# 배분 시뮬레이터 Sheets → qradar 적재: npm run migrate:dist-sheets -- --target=dev
# (ADC에 Sheets 스코프 필요 — scripts/migrate-dist-sheets-to-bq.ts 헤더 참고)

# Slack — 평가자 이메일 매핑·유저 동기화 (/admin/slack-users)
# Bot User OAuth Token (users:read, users:read.email 스코프)
# SLACK_BOT_TOKEN=xoxb-...

# STT용 GCS 버킷 — 기본값 qms_qradar (data-proj-470202).
# STT는 STT_TEMP_BUCKET → 없으면 GCS_FEEDBACK_BUCKET → 기본값 순.
# STT_TEMP_BUCKET=
# GCS_FEEDBACK_BUCKET=qms_qradar
#
# STT 엔진 선택
# - 기본값: v1
# - v2_dynamic_batch: 더 저렴할 수 있지만 응답이 느릴 수 있음(배치 처리)
# STT_API_VERSION=v1
# STT_LANGUAGE=ko-KR
# STT_MODEL=latest_long
#
# v2 전용 설정
# recognizer "_" 는 암시적 기본 recognizer 사용
# STT_V2_LOCATION=global
# STT_V2_RECOGNIZER=_
# STT_V2_DYNAMIC_BATCH=1

# 로컬 STT 배치 서버 (평가 진행 온디맨드 GCP STT 와 분리)
# 일일 콜을 구성원당 N건 모아 여기 큐에 넣는다. 서버는 유휴 자원일 때만 처리.
LOCAL_STT_BASE_URL=http://127.0.0.1:8760
# 서버에 STT_API_KEY가 있을 때만. 헤더 X-API-Key
# LOCAL_STT_API_KEY=
# LOCAL_STT_LANGUAGE=ko
# 콜백을 쓸 때만 (STT 서버가 이 앱에 도달 가능해야 함). 없으면 1분 폴링으로 회수.
# LOCAL_STT_CALLBACK_URL=http://127.0.0.1:3000/api/eval-ops/stt-batch/callback
# LOCAL_STT_CALLBACK_SECRET=
