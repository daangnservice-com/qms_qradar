# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# 처리 설정 (콜 품질 평가)
SILENCE_NOISE_DB=-30
MAX_UPLOAD_MB=200

# 처리 설정 (파손 판별)
MAX_IMAGES=8
MAX_IMAGE_MB=10

